# HR Assistant API — backend/.env.example
# Copy to backend/.env and adjust per environment. Do not commit real .env
# files; secrets belong in the deployment secrets manager.
#
# pydantic-settings loads .env relative to the working directory (see
# app/core/config.py, SettingsConfigDict(env_file=".env")); variable names are
# case-insensitive.

# --- Application -------------------------------------------------------------
# Deployment environment: development | test | staging | production.
# In production, startup fails fast on unsafe configuration (DEBUG on,
# placeholder JWT secret, wildcard CORS).
APP_ENV=development
# Verbose logging and OpenAPI docs. Never enable in production.
DEBUG=false
# Mounted API prefix for the versioned router.
API_PREFIX=/api/v1

# --- Database ----------------------------------------------------------------
# SQLAlchemy URL. postgres:// and postgresql:// URLs are normalised to the
# psycopg3 driver automatically. Use a least-privilege application role; run
# migrations with a separate DDL role (backend.md §6.7).
DATABASE_URL=postgresql+psycopg://myuser:mypass@localhost:5432/hr_assist
# Log every SQL statement (development only).
DATABASE_ECHO=false
# Connection-pool sizing; tune from load test results, not defaults.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Security / sessions -----------------------------------------------------
# REQUIRED: at least 32 characters; must be replaced in every environment.
# Rotate through the secrets manager, never through source control.
JWT_SECRET_KEY=change-me-in-production-with-a-32+-char-value
JWT_ALGORITHM=HS256
# Access tokens are short-lived; refresh sessions live server-side for
# REFRESH_TOKEN_EXPIRE_DAYS and are revocable (user_sessions).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Password hashing backend (argon2 recommended).
PASSWORD_HASH_ALGORITHM=argon2

# --- HTTP hardening ----------------------------------------------------------
# Comma-separated allowlist of browser origins. Wildcard values are rejected
# in production; do not use "*" with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated allowed Host header values for TrustedHostMiddleware.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# --- Localization ------------------------------------------------------------
# Default locale for server-generated content when the user preference and
# Accept-Language resolve to nothing: en | hi.
DEFAULT_LOCALE=en

# --- Rate limiting (per-user / per-IP budgets, requests per minute) ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_PUBLIC_WRITE_PER_MINUTE=10
# Replay window for idempotency keys before the cleanup job deletes them (§6.9).
IDEMPOTENCY_TTL_HOURS=24

# --- Pagination / input bounds ----------------------------------------------
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
MAX_QUESTION_CHARS=2000

# --- Observability -----------------------------------------------------------
# /metrics is disabled in production unless explicitly enabled (unauthenticated
# endpoint; gate it at the listener instead).
METRICS_ENABLED=false

# --- Documents / uploads -----------------------------------------------------
# Reject registrations above this size; bytes stay in private object storage.
DOCUMENT_MAX_SIZE_MB=10
# Comma-separated MIME allowlist for registered documents.
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# --- Integration adapters (SRS leaves providers open; defaults are local) ---
# Deterministic local extraction; no external AI provider is contacted.
AI_PROVIDER=local_extractive
AI_MODEL_NAME=local-extractive-v1
# Metadata-only storage adapter: registers metadata, stores no bytes; real
# deployments point DB metadata at an approved private object store.
OBJECT_STORAGE_PROVIDER=local_metadata
# In-app notifications only until an email/SMS provider and approved
# localized templates are selected (§8.10).
NOTIFICATION_PROVIDER=in_app
